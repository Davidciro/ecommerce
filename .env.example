# -----------------------------------------------------------------------------
# Supabase  (Dashboard → Project Settings → API Keys)
# -----------------------------------------------------------------------------
# Público: llega al navegador. Es seguro porque RLS protege los datos.
NUXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# "Publishable key" (sb_publishable_...) o la legacy "anon key" (eyJ...)
NUXT_PUBLIC_SUPABASE_KEY=

# SOLO SERVIDOR — salta RLS. Nunca prefijar con NUXT_PUBLIC_ ni commitear.
# "Secret key" (sb_secret_...) o la legacy "service_role key" (eyJ...)
NUXT_SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Sitio
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_DEFAULT_LOCALE=de

# -----------------------------------------------------------------------------
# Resend (emails transaccionales y campañas) — solo servidor
# -----------------------------------------------------------------------------
NUXT_RESEND_API_KEY=
NUXT_RESEND_FROM_EMAIL="Mi Tienda <shop@example.ch>"
NUXT_ADMIN_NOTIFICATION_EMAIL=

# Las llaves de Stripe NO van aquí: el dueño las introduce en
# Admin → Configuración de Pagos y Tienda (tablas store_settings / store_secrets).
